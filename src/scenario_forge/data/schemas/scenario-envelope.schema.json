{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scenario-forge.dev/schemas/scenario-envelope.schema.json",
  "title": "ScenarioEnvelope",
  "description": "Top-level scenario document wrapping all four output layers of a scenario-forge scenario.",
  "type": "object",
  "required": [
    "scenario_id",
    "candidate_id",
    "generated_at",
    "generator_version",
    "narrative",
    "attack_tree",
    "behavior_spec",
    "faceting",
    "priority",
    "generation"
  ],
  "properties": {
    "scenario_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^scenario:v2:[0-9a-f]{64}$",
      "description": "Collision-safe, run-specific identifier: scenario:<version>:<256-bit hex digest of run_id|candidate_id|attempt>."
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^cand:v1:[0-9a-f]{32}$",
      "description": "Stable canonical candidate identity (cand:v1:<128-bit hex>) that produced this scenario."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "default": 2
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "generator_version": {
      "type": "string",
      "minLength": 1
    },
    "scenario_seed_metadata": {
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "legitimate_task": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "actor_profile": {
      "oneOf": [
        {
          "$ref": "#/$defs/ActorProfile"
        },
        {
          "type": "null"
        }
      ]
    },
    "narrative": {
      "$ref": "#/$defs/NarrativeLayer"
    },
    "attack_tree": {
      "$ref": "#/$defs/AttackTree"
    },
    "behavior_spec": {
      "description": "Tool-neutral test specification. Stored as dict or Gherkin text."
    },
    "faceting": {
      "$ref": "#/$defs/FacetingMetadata"
    },
    "priority": {
      "$ref": "#/$defs/Priority"
    },
    "candidate_filter": {
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "validation": {
      "oneOf": [
        {
          "$ref": "#/$defs/ValidationBlock"
        },
        {
          "type": "null"
        }
      ]
    },
    "validation_passed": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "generation": {
      "$ref": "#/$defs/GenerationMetadata"
    },
    "initial_entry_point_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^ep:v1:[0-9a-f]{32}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "ActorProfile": {
      "type": "object",
      "required": [
        "actor_type",
        "capability_level",
        "beliefs",
        "desires",
        "intentions",
        "resources"
      ],
      "properties": {
        "actor_type": {
          "type": "string",
          "enum": [
            "cybercriminal",
            "nation-state",
            "malicious-insider",
            "negligent-insider",
            "competitor",
            "hacktivist",
            "supply-chain-actor",
            "adversarial-user",
            "automated-agent"
          ]
        },
        "capability_level": {
          "type": "string",
          "enum": [
            "novice",
            "intermediate",
            "advanced",
            "expert"
          ]
        },
        "beliefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "desires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "intentions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "goal_category": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "goal_category_name": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "goal_category_parent": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "access": {
          "oneOf": [
            {
              "$ref": "#/$defs/ActorAccessProvenance"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "NarrativeStep": {
      "type": "object",
      "required": [
        "step_number",
        "zone",
        "action",
        "effect"
      ],
      "properties": {
        "step_number": {
          "type": "integer",
          "minimum": 1
        },
        "zone": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "type": "string",
          "minLength": 1
        },
        "control_point": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "NarrativeLayer": {
      "type": "object",
      "required": [
        "title",
        "summary",
        "entry_point",
        "zone_sequence",
        "steps"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "entry_point": {
          "type": "string",
          "minLength": 1
        },
        "zone_sequence": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NarrativeStep"
          },
          "minItems": 1
        }
      }
    },
    "AiSystemAction": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "ai_system_action",
          "default": "ai_system_action"
        }
      },
      "additionalProperties": false
    },
    "ExternalPreconditionAction": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "external_precondition",
          "default": "external_precondition"
        },
        "access_provenance": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "ImpactAction": {
      "type": "object",
      "required": [
        "kind",
        "boundary",
        "target"
      ],
      "properties": {
        "kind": {
          "const": "impact",
          "default": "impact"
        },
        "boundary": {
          "type": "string",
          "enum": [
            "internal",
            "external"
          ]
        },
        "target": {
          "type": "string",
          "maxLength": 200
        }
      },
      "additionalProperties": false
    },
    "ToolInvocationAction": {
      "type": "object",
      "required": [
        "kind",
        "tool_id"
      ],
      "properties": {
        "kind": {
          "const": "tool_invocation",
          "default": "tool_invocation"
        },
        "tool_id": {
          "type": "string",
          "pattern": "^tool:v1:[0-9a-f]{32}$"
        },
        "integration_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^int:v1:[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "additionalProperties": false
    },
    "IntegrationInteractionAction": {
      "type": "object",
      "required": [
        "kind",
        "integration_id"
      ],
      "properties": {
        "kind": {
          "const": "integration_interaction",
          "default": "integration_interaction"
        },
        "integration_id": {
          "type": "string",
          "pattern": "^int:v1:[0-9a-f]{32}$"
        }
      },
      "additionalProperties": false
    },
    "InitialIngressAction": {
      "type": "object",
      "required": [
        "kind",
        "entry_point_id"
      ],
      "properties": {
        "kind": {
          "const": "initial_ingress",
          "default": "initial_ingress"
        },
        "entry_point_id": {
          "type": "string",
          "pattern": "^ep:v1:[0-9a-f]{32}$"
        }
      },
      "additionalProperties": false
    },
    "AttackTreeNode": {
      "type": "object",
      "required": [
        "id",
        "label",
        "gate"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^n\\d+(\\.\\d+){0,4}$"
        },
        "label": {
          "type": "string",
          "maxLength": 120
        },
        "description": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "gate": {
          "type": "string",
          "enum": [
            "AND",
            "OR",
            "LEAF"
          ]
        },
        "zone": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "action": {
          "oneOf": [
            {
              "$ref": "#/$defs/AiSystemAction"
            },
            {
              "$ref": "#/$defs/ExternalPreconditionAction"
            },
            {
              "$ref": "#/$defs/ImpactAction"
            },
            {
              "$ref": "#/$defs/ToolInvocationAction"
            },
            {
              "$ref": "#/$defs/IntegrationInteractionAction"
            },
            {
              "$ref": "#/$defs/InitialIngressAction"
            },
            {
              "type": "null"
            }
          ]
        },
        "threat_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^T\\d+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "technique_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(AML\\.T\\d{4}(\\.\\d{3})?|(S|M|L|T|EX)\\d+)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "tactic": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^AML\\.TA\\d{4}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "maestro_layer": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            },
            {
              "type": "null"
            }
          ]
        },
        "control_point": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "structural_exposure": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "single_point_of_failure",
                "convergence_point",
                "probabilistic_control",
                "defense_in_depth_claim"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_level": {
          "oneOf": [
            {
              "type": "string",
              "enum": [
                "assumed",
                "design-reviewed",
                "lab-validated",
                "end-to-end-validated",
                "regression-tested"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "children": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AttackTreeNode"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "gate": {
                "const": "LEAF"
              }
            }
          },
          "then": {
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/AiSystemAction"
                  },
                  {
                    "$ref": "#/$defs/ExternalPreconditionAction"
                  },
                  {
                    "$ref": "#/$defs/ImpactAction"
                  },
                  {
                    "$ref": "#/$defs/ToolInvocationAction"
                  },
                  {
                    "$ref": "#/$defs/IntegrationInteractionAction"
                  },
                  {
                    "$ref": "#/$defs/InitialIngressAction"
                  }
                ]
              },
              "children": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "array",
                    "maxItems": 0
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "gate": {
                "enum": [
                  "AND",
                  "OR"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "action": {
                "type": "null"
              },
              "children": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/AttackTreeNode"
                },
                "minItems": 2
              }
            },
            "required": [
              "children"
            ]
          }
        },
        {
          "if": {
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "external_precondition"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "zone": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "ai_system_action"
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "zone"
            ],
            "properties": {
              "zone": {
                "type": "string",
                "enum": [
                  "input",
                  "reasoning",
                  "tool_execution",
                  "memory",
                  "inter_agent"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "tool_invocation"
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "zone"
            ],
            "properties": {
              "zone": {
                "const": "tool_execution"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "integration_interaction"
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "zone"
            ],
            "properties": {
              "zone": {
                "type": "string",
                "enum": [
                  "input",
                  "reasoning",
                  "tool_execution",
                  "memory",
                  "inter_agent"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "type": "object",
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "initial_ingress"
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "zone"
            ],
            "properties": {
              "zone": {
                "type": "string",
                "enum": [
                  "input",
                  "reasoning",
                  "tool_execution",
                  "memory",
                  "inter_agent"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "type": "object",
                "required": [
                  "kind",
                  "boundary"
                ],
                "properties": {
                  "kind": {
                    "const": "impact"
                  },
                  "boundary": {
                    "const": "internal"
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "zone"
            ],
            "properties": {
              "zone": {
                "type": "string",
                "enum": [
                  "input",
                  "reasoning",
                  "tool_execution",
                  "memory",
                  "inter_agent"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "action"
            ],
            "properties": {
              "action": {
                "type": "object",
                "required": [
                  "kind",
                  "boundary"
                ],
                "properties": {
                  "kind": {
                    "const": "impact"
                  },
                  "boundary": {
                    "const": "external"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "zone": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "AttackTree": {
      "type": "object",
      "required": [
        "id",
        "seed_id",
        "goal",
        "root"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^tree-AP-T\\d+-\\d+$"
        },
        "seed_id": {
          "type": "string",
          "pattern": "^AP-T\\d+-\\d+$"
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "root": {
          "$ref": "#/$defs/AttackTreeNode"
        }
      }
    },
    "RiskCardRef": {
      "type": "object",
      "required": [
        "risk_id",
        "risk_name",
        "risk_description",
        "taxonomy",
        "confidence",
        "grounding_confidence"
      ],
      "properties": {
        "risk_id": {
          "type": "string"
        },
        "risk_name": {
          "type": "string"
        },
        "risk_description": {
          "type": "string"
        },
        "taxonomy": {
          "type": "string",
          "const": "ibm-risk-atlas"
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "grounding_confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "threat": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "threat_source": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "vulnerability": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "consequence": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "impact": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "TaxonomyChain": {
      "type": "object",
      "required": [
        "owasp_llm_ids",
        "agentic_threat_ids",
        "scenario_seed"
      ],
      "properties": {
        "owasp_llm_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "agentic_threat_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "owasp_asi_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "atlas_technique_ids": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^AML\\.T\\d{4}(\\.\\d{3})?$"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "scenario_seed": {
          "type": "string",
          "pattern": "^AP-T\\d+-\\d+$"
        }
      }
    },
    "CapabilityProfileRef": {
      "type": "object",
      "required": [
        "zones_traversed",
        "architecture_match",
        "entry_point"
      ],
      "properties": {
        "zones_traversed": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "architecture_match": {
          "type": "string",
          "enum": [
            "explicit",
            "inferred"
          ]
        },
        "entry_point": {
          "type": "string"
        }
      }
    },
    "FacetingMetadata": {
      "type": "object",
      "required": [
        "risk_card",
        "taxonomy_chain",
        "capability_profile",
        "maestro_layers"
      ],
      "properties": {
        "risk_card": {
          "$ref": "#/$defs/RiskCardRef"
        },
        "taxonomy_chain": {
          "$ref": "#/$defs/TaxonomyChain"
        },
        "capability_profile": {
          "$ref": "#/$defs/CapabilityProfileRef"
        },
        "maestro_layers": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "minItems": 1
        }
      }
    },
    "PrioritySignals": {
      "type": "object",
      "required": [
        "technique_maturity",
        "risk_impact",
        "risk_likelihood",
        "attack_complexity",
        "architecture_match",
        "structural_exposure"
      ],
      "properties": {
        "technique_maturity": {
          "type": "string",
          "enum": [
            "feasible",
            "demonstrated",
            "realized"
          ]
        },
        "risk_impact": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "risk_likelihood": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "attack_complexity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "architecture_match": {
          "type": "string",
          "enum": [
            "explicit",
            "inferred"
          ]
        },
        "structural_exposure": {
          "type": "string",
          "enum": [
            "single_point_of_failure",
            "convergence_point",
            "probabilistic_control",
            "defense_in_depth_claim",
            "none"
          ]
        }
      }
    },
    "Priority": {
      "type": "object",
      "required": [
        "composite",
        "signals"
      ],
      "properties": {
        "composite": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "signals": {
          "$ref": "#/$defs/PrioritySignals"
        }
      }
    },
    "CallMetadata": {
      "type": "object",
      "required": [
        "call",
        "prompt_tokens",
        "completion_tokens",
        "duration_ms"
      ],
      "properties": {
        "call": {
          "type": "string",
          "enum": [
            "actor_profile",
            "narrative",
            "attack_tree",
            "behavior_spec"
          ]
        },
        "prompt_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "completion_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "GenerationMetadata": {
      "type": "object",
      "required": [
        "model",
        "call_metadata"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "call_metadata": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CallMetadata"
          }
        },
        "notes": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "PhantomViolationRecord": {
      "type": "object",
      "required": [
        "step_number",
        "field",
        "category",
        "matched_text",
        "reason"
      ],
      "properties": {
        "step_number": {
          "type": "integer",
          "minimum": 0
        },
        "field": {
          "type": "string"
        },
        "category": {
          "type": "string"
        },
        "matched_text": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "PhantomValidation": {
      "type": "object",
      "required": [
        "valid"
      ],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "violations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PhantomViolationRecord"
          }
        }
      }
    },
    "SemanticViolation": {
      "type": "object",
      "required": [
        "rule",
        "message"
      ],
      "properties": {
        "rule": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "major",
            "moderate",
            "minor"
          ],
          "default": "major"
        }
      }
    },
    "StructuralValidation": {
      "type": "object",
      "required": [
        "valid"
      ],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "CorpusClaimApplicability": {
      "type": "object",
      "required": [
        "category",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "entry_points",
            "tool_inventory"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "applicable",
            "not_applicable"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "applicable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "type": "null"
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            },
            "required": [
              "evidence"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_applicable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "reason": {
                "type": "string",
                "pattern": "\\S"
              },
              "evidence": {
                "type": "array",
                "maxItems": 0
              }
            },
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "SemanticValidation": {
      "type": "object",
      "required": [
        "valid",
        "corpus_claim_applicability"
      ],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "violations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SemanticViolation"
          }
        },
        "corpus_claim_applicability": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CorpusClaimApplicability"
          },
          "minItems": 2,
          "maxItems": 2,
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "category": {
                    "const": "entry_points"
                  }
                },
                "required": [
                  "category"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "category": {
                    "const": "tool_inventory"
                  }
                },
                "required": [
                  "category"
                ]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        }
      }
    },
    "ValidationBlock": {
      "type": "object",
      "properties": {
        "phantom": {
          "$ref": "#/$defs/PhantomValidation"
        },
        "structural": {
          "$ref": "#/$defs/StructuralValidation"
        },
        "semantic": {
          "$ref": "#/$defs/SemanticValidation"
        }
      }
    },
    "ActorAccessProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initial_entry_point_id",
        "access_class"
      ],
      "properties": {
        "initial_entry_point_id": {
          "type": "string",
          "pattern": "^ep:v1:[0-9a-f]{32}$"
        },
        "access_class": {
          "type": "string",
          "enum": [
            "direct",
            "indirect"
          ]
        },
        "influence_source": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "influence_mechanism": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "trust_boundary": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "material_insider_advantage": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
