{
  "$defs": {
    "MetricResult": {
      "additionalProperties": false,
      "description": "One typed metric observation.\n\n``value`` is always a bounded ratio. Counts are represented by numerator\n(and denominator when they are rates), never overloaded into ``value``.",
      "properties": {
        "status": {
          "$ref": "#/$defs/MetricStatus"
        },
        "definition_version": {
          "const": "1",
          "default": "1",
          "title": "Definition Version",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "numerator": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator"
        },
        "denominator": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "affected_ids": {
          "items": {
            "type": "string"
          },
          "title": "Affected Ids",
          "type": "array"
        }
      },
      "required": [
        "status",
        "evidence",
        "affected_ids"
      ],
      "title": "MetricResult",
      "type": "object"
    },
    "MetricSection": {
      "additionalProperties": false,
      "properties": {
        "metrics": {
          "additionalProperties": {
            "$ref": "#/$defs/MetricResult"
          },
          "title": "Metrics",
          "type": "object"
        }
      },
      "required": [
        "metrics"
      ],
      "title": "MetricSection",
      "type": "object"
    },
    "MetricStatus": {
      "enum": [
        "pass",
        "fail",
        "not_applicable",
        "error"
      ],
      "title": "MetricStatus",
      "type": "string"
    },
    "QualificationResult": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/MetricStatus"
        },
        "applicable_gate_count": {
          "minimum": 0,
          "title": "Applicable Gate Count",
          "type": "integer"
        },
        "passed_gate_count": {
          "minimum": 0,
          "title": "Passed Gate Count",
          "type": "integer"
        },
        "failed_gate_ids": {
          "items": {
            "type": "string"
          },
          "title": "Failed Gate Ids",
          "type": "array"
        },
        "error_gate_ids": {
          "items": {
            "type": "string"
          },
          "title": "Error Gate Ids",
          "type": "array"
        },
        "not_applicable_gate_ids": {
          "items": {
            "type": "string"
          },
          "title": "Not Applicable Gate Ids",
          "type": "array"
        },
        "blocking_not_applicable_gate_ids": {
          "items": {
            "type": "string"
          },
          "title": "Blocking Not Applicable Gate Ids",
          "type": "array"
        }
      },
      "required": [
        "status",
        "applicable_gate_count",
        "passed_gate_count",
        "failed_gate_ids",
        "error_gate_ids",
        "not_applicable_gate_ids",
        "blocking_not_applicable_gate_ids"
      ],
      "title": "QualificationResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Versioned evaluation scorecard with intentionally separate lenses.",
  "properties": {
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "manifest_version": {
      "const": "3",
      "default": "3",
      "title": "Manifest Version",
      "type": "string"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "scenario_count": {
      "minimum": 0,
      "title": "Scenario Count",
      "type": "integer"
    },
    "feature_file_count": {
      "minimum": 0,
      "title": "Feature File Count",
      "type": "integer"
    },
    "presence_coverage": {
      "$ref": "#/$defs/MetricSection"
    },
    "validity_grounding": {
      "$ref": "#/$defs/MetricSection"
    },
    "cross_artifact_agreement": {
      "$ref": "#/$defs/MetricSection"
    },
    "semantic_quality_diagnostics": {
      "$ref": "#/$defs/MetricSection"
    },
    "release_qualification": {
      "$ref": "#/$defs/MetricSection"
    },
    "qualification": {
      "$ref": "#/$defs/QualificationResult"
    }
  },
  "required": [
    "run_id",
    "scenario_count",
    "feature_file_count",
    "presence_coverage",
    "validity_grounding",
    "cross_artifact_agreement",
    "semantic_quality_diagnostics",
    "release_qualification",
    "qualification"
  ],
  "title": "ScorecardV1",
  "type": "object"
}
