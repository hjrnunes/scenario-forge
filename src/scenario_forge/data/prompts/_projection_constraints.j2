{% if projection_context is defined and projection_context %}
## Canonical Projection Constraints (INVARIANT — scenario-forge-422o.4)
You MUST follow but NEVER alter, omit, reorder, or fabricate the
projection semantics below.  These constraints are fixed and immutable.
Every generated artifact (narrative, attack tree, behavior spec) must
trace back to these exact projected steps and resource bindings.

### Canonical Ingress
- entry_point: {{ projection_context.canonical_ingress_name | default(projection_context.canonical_ingress.entry_point_id) }}
- ingress_controllability: {{ projection_context.ingress_controllability }}

### Selected Projected Steps (ordered — preserve this total order)
{% for step in projection_context.selected_steps %}
{{ loop.index }}. step_id: {{ step.step_id }}
   - action_kind: {{ step.action_kind }}
   - executor_role: {{ step.executor_role }}
   - boundary_position: {{ step.boundary_position }}
   - attacker_controlled: {{ step.attacker_controlled }}
   - requirement: {{ step.requirement }}
   - resource_links:
   {% for link in step.resource_links %}     - slot_id: {{ link.slot_id }}, role: {{ link.role }}{% if link.trust_boundary_slot_id %}, trust_boundary: {{ link.trust_boundary_slot_id }}{% endif %}{% if link.target_ingress_slot_id %}, target_ingress: {{ link.target_ingress_slot_id }}{% endif %}{% if link.resource_ref %}, resource_ref: {{ link.resource_ref | tojson }}{% endif %}
   {% endfor %}
{% endfor %}

### Omitted Steps
{% if projection_context.omitted_step_ids %}{{ projection_context.omitted_step_ids | join(', ') }}
{% else %}(none)
{% endif %}

### Condition Results (full evaluations with evidence)
{% for cr in projection_context.condition_results %}- step {{ cr.condition_step_id }}: result={{ cr.result }}
  {% for e in cr.evidence %}  - evidence: fact={{ e.fact.namespace }}/{{ e.fact.fact_id }}, status={{ e.status }}, value={{ e.value }}
  {% endfor %}{% else %}(none)
{% endfor %}

### Condition Evaluations (precondition summary)
{% for ce in projection_context.condition_evaluations %}- step {{ ce.step_id }} / condition {{ ce.condition_id }}: {{ ce.result }}
{% else %}(none)
{% endfor %}

### Execution Requirements (adapter-neutral)
{% for req in projection_context.execution_requirements %}- {{ req.requirement_id }}: kind={{ req.kind }}
   {{ req | tojson }}
{% else %}(none)
{% endfor %}

### Projected Taxonomy Mappings
{% for m in projection_context.projected_mappings %}- step_id={{ m.step_id }}: {{ m.mapping.taxonomy }} / {{ m.mapping.decision }} — {{ m.mapping | tojson }}
{% else %}(none)
{% endfor %}

### Resource Slots (with concrete bindings)
{% for slot in projection_context.resource_slots %}- {{ slot.slot_id }}: kind={{ slot.kind }}, purpose={{ slot.purpose }}{% if slot.resource_ref %}, resource_ref: {{ slot.resource_ref | tojson }}{% endif %}
{% else %}(none)
{% endfor %}

### Concrete Resource Bindings
{% for b in projection_context.bindings %}- slot_id: {{ b.slot_id }}, resource_ref: {{ b.resource_ref | tojson }}
{% else %}(none)
{% endfor %}

{% endif %}
