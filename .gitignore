# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv*/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store

# Secrets / local env
.envrc

# Scratch. Nothing here is load-bearing: the acceptance suite that used to
# live under tmp/acceptance/ now lives at acceptance/.
tmp/

# Experiment worktrees are separate checkouts, not content of this one
.worktrees/

# Quality-tool output, regenerated on every run
acceptance/dry/
acceptance/ir/
acceptance/generated/
lcov*.info
coverage.lcov
.coverage

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Pipeline output
output/

# AI working files (findings are exploratory, not committed)
ai/findings/
ai/lab-results/
ai/.DS_Store
.opencode
opencode.json

# SwarmForge runtime state (handoffs, roles.tsv)
.swarmforge/
# APS clone — each developer clones separately
.factory/swarmforge/aps/

# Real model profiles (contains API keys — copy from ai/model-profiles.example.yaml)
ai/model-profiles.yaml
